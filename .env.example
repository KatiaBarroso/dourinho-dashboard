# Supabase (Project Settings > API Keys) — use a chave secret/service_role, nunca a publishable
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-secret-key

# Conexão Postgres usada só pelo npm run db:setup (Connect > Session pooler)
SUPABASE_DB_URL=""

# Segredo para assinar o JWT da sessão (mínimo 32 caracteres)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-chars

# Colaborador inicial criado por: npm run seed:admin
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_POSITION=Administrador
SEED_ADMIN_PASSWORD=troque-esta-senha
